# Edit this file before running anything. All scripts source it.
# Paths must be absolute.

# Directory on the NVMe array under test. Must be a real block-device filesystem that supports
# O_DIRECT (ext4/xfs on NVMe or md RAID). NOT tmpfs, NOT NFS/Lustre/network storage.
# Needs >= 180 GiB free (8 x 10 GiB + 8 x 4 GiB restore files + 32 GiB fio files + margin).
DATA_DIR=/tmp/kvr-USER-484280-vl7RdG

# Where results go. Any local disk; a few GB at most.
OUT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/out

# GPUs to use, physical indices as nvidia-smi shows them. 8 are expected; fewer is allowed
# (record it), the G sweep then stops at the number of GPUs listed.
# Under Slurm, use the indices nvidia-smi shows INSIDE the allocation (usually 0..n-1).
# run_1gpu.sh overrides this with GPUS_OVERRIDE.
GPUS="0 1 2 3 4 5 6 7"

# Restore pipeline settings per process (H200 tuning: copy mode, 8 threads, QD 32).
KVR_THREADS=8
KVR_QD=32
KVR_MODE=copy

# Repetitions per multi-GPU configuration (each repetition relaunches all processes together).
REPS=5

# Python environment with vllm==0.10.1.1 (only stages 30 and 40 need it). Leave empty to skip
# those stages. Example: VLLM_PY=/opt/venvs/kvr/bin/python
VLLM_PY=

# Local model directories (downloaded snapshots). 8B is required for stages 30/40;
# 70B is optional (only measured when one GPU has >= 120 GB memory).
MODEL_8B=/work/USER/models/llama31-8b-fp8
MODEL_70B=/work/USER/models/llama33-70b-fp8

# Background write rate for the write-interference stage, in MB/s. Empty = 20% of the
# measured fio sequential read bandwidth.
WB_RATE_MBS=
